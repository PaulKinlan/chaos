{
  "name": "@paulkinlan/chaos-relay",
  "version": "0.1.165",
  "exports": "./src/main.ts",
  "tasks": {
    "dev": "deno run --watch --allow-net --allow-read --allow-env --unstable-kv src/main.ts",
    "start": "deno run --allow-net --allow-read --allow-write --allow-env --unstable-kv src/main.ts",
    "test": "deno test --allow-all --unstable-kv src/__tests__/",
    "test:conformance": "deno test --allow-all tests/conformance/"
  },
  "imports": {
    "@chaos/shared": "../shared/src/types.ts"
  },
  "deploy": {
    "org": "paulkinlan-ea",
    "app": "chaos"
  }
}
